  "django_models.py": {
    "format": "django",
    "tables": [
      {
        "name": "Author",
        "columns": [
          "id | bigint | pk notnull",
          "created_at | timestamp | notnull",
          "name | varchar(100) | notnull",
          "email | varchar | unique notnull",
          "bio | text"
        ]
      },
      {
        "name": "Book",
        "columns": [
          "id | bigint | pk notnull",
          "created_at | timestamp | notnull",
          "title | varchar(200) | notnull",
          "author_id | bigint | fk notnull",
          "editor_id | bigint | fk",
          "price | decimal(8,2) | notnull",
          "sequel_of_id | bigint | fk unique"
        ]
      },
      {
        "name": "book_tags",
        "columns": [
          "id | bigint | pk notnull",
          "book_id | bigint | fk notnull",
          "tag_id | bigint | fk notnull"
        ]
      },
      {
        "name": "pub_publisher",
        "columns": [
          "id | bigint | pk notnull",
          "name | varchar(120) | notnull"
        ]
      },
      {
        "name": "pub_publisher_books",
        "columns": [
          "id | bigint | pk notnull",
          "publisher_id | bigint | fk notnull",
          "book_id | bigint | fk notnull"
        ]
      },
      {
        "name": "Tag",
        "columns": [
          "slug | varchar | pk notnull"
        ]
      }
    ],
    "relations": [
      "Book(author_id) -> Author(id)",
      "Book(editor_id) -> Author(id)",
      "Book(sequel_of_id) -> Book(id)",
      "book_tags(book_id) -> Book(id)",
      "book_tags(tag_id) -> Tag(slug)",
      "pub_publisher_books(book_id) -> Book(id)",
      "pub_publisher_books(publisher_id) -> pub_publisher(id)"
    ],
    "warnings": []
  },
