{
  "diagram.mmd": {
    "format": "mermaid",
    "tables": [
      {
        "name": "CUSTOMER",
        "columns": [
          "id | int | pk",
          "name | string",
          "email | string | unique"
        ]
      },
      {
        "name": "LINE_ITEM",
        "columns": [
          "order_id | int | fk",
          "sku | string",
          "qty | int"
        ]
      },
      {
        "name": "ORDER",
        "columns": [
          "id | int | pk",
          "customer_id | int | fk",
          "placed_on | date"
        ]
      }
    ],
    "relations": [
      "LINE_ITEM() -> ORDER()",
      "ORDER() -> CUSTOMER()"
    ],
    "warnings": []
  },
